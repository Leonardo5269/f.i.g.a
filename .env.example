# ── F.I.G.A. · variabili d'ambiente ─────────────────────────────────────────
# Copia questo file in `.env.local` e compila i valori.
# I segreti NON vanno mai committati: `.env.local` è già in .gitignore.

# Chiave segreta Stripe. In sviluppo usa quella del sandbox.
# Dashboard Stripe → Sviluppatori → Chiavi API.
STRIPE_SECRET_KEY=sk_test_xxx

# Segreto di firma del webhook, per verificare gli eventi Stripe.
# In locale: `stripe listen --forward-to localhost:3000/api/webhook`
# stampa un `whsec_...`. In produzione: dall'endpoint webhook in dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Origin pubblico dell'app: base dei redirect success/cancel del checkout.
# In locale è l'URL del dev server; in produzione il dominio Vercel.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
